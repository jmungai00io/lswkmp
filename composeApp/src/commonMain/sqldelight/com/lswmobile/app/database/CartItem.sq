-- CartItem table to store both products and farmlands agnostically
CREATE TABLE CartItem (
    id TEXT PRIMARY KEY NOT NULL,
    itemId TEXT NOT NULL, -- The actual product/farmland ID from API
    itemType TEXT NOT NULL, -- 'PRODUCT' or 'FARMLAND'
    quantity INTEGER NOT NULL,
    price REAL NOT NULL,
    name TEXT NOT NULL,
    location TEXT,
    images TEXT, -- JSON array as string
    profitRate TEXT,
    profitCycle TEXT,
    unitCount TEXT,
    productType TEXT,
    investmentTerm TEXT,
    dividendCycle TEXT,
    profitInformation TEXT,
    count TEXT,
    inStock INTEGER, -- 0 for false, 1 for true
    isArchived INTEGER, -- 0 for false, 1 for true
    infoUrl TEXT,
    userId TEXT NOT NULL, -- To handle different user logins
    createdAt INTEGER NOT NULL -- Unix timestamp
);

-- Index for faster queries
CREATE INDEX CartItem_userId_itemType ON CartItem(userId, itemType);
CREATE INDEX CartItem_userId_createdAt ON CartItem(userId, createdAt);

-- Insert a new cart item
insertCartItem:
INSERT INTO CartItem(
    id, itemId, itemType, quantity, price, name, location, images, 
    profitRate, profitCycle, unitCount, productType, investmentTerm, 
    dividendCycle, profitInformation, count, inStock, isArchived, 
    infoUrl, userId, createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get all cart items for a user
getCartItems:
SELECT * FROM CartItem 
WHERE userId = ? 
ORDER BY createdAt DESC;

-- Get cart items by type for a user
getCartItemsByType:
SELECT * FROM CartItem 
WHERE userId = ? AND itemType = ? 
ORDER BY createdAt DESC;

-- Get a specific cart item
getCartItem:
SELECT * FROM CartItem 
WHERE id = ? AND userId = ?;

-- Update cart item quantity
updateCartItemQuantity:
UPDATE CartItem 
SET quantity = ? 
WHERE id = ? AND userId = ?;

-- Delete a cart item
deleteCartItem:
DELETE FROM CartItem 
WHERE id = ? AND userId = ?;

-- Clear all cart items for a user
clearCart:
DELETE FROM CartItem 
WHERE userId = ?;

-- Get cart summary (count and total price)
getCartSummary:
SELECT 
    COUNT(*),
    SUM(quantity),
    SUM(quantity * price)
FROM CartItem 
WHERE userId = ?;

-- Get cart summary by type
getCartSummaryByType:
SELECT 
    COUNT(*),
    SUM(quantity),
    SUM(quantity * price)
FROM CartItem 
WHERE userId = ? AND itemType = ?; 